// CLOSURE data model.
// Postgres for real persistence (originally scaffolded on SQLite — see git
// history if you need the zero-config single-file version back).
//
// Status/category fields are still plain String columns constrained by the
// TS union types in src/domain/*.ts (documented alongside each field
// below), not real Postgres `enum` types. That was a SQLite limitation
// originally; kept as String here too, deliberately, so this migration
// only changes the connector, not every route/domain function's types —
// converting to real enums is a separate, larger refactor if wanted later.
//
// A real vector column (pgvector) for PreferenceProfile.vector is a
// similarly separate future step — it's still a JSON-encoded float array
// compared in application code (src/domain/matching.ts), same as before.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  displayName        String
  createdAt          DateTime @default(now())

  /// "UNVERIFIED" | "PENDING" | "VERIFIED" | "FAILED"
  verificationStatus String   @default("UNVERIFIED")
  accountabilityScore Float   @default(100) // starts at 100, moves with behavior

  // Leveling (src/domain/leveling.ts): xp only ever goes up, earned by
  // answering real trust prompts honestly with real matches — distinct
  // from accountabilityScore, which is a penalty/trust ledger that can
  // fall. Level itself is derived from xp (levelForXp), not stored.
  xp                 Int      @default(0)
  promptResponses    MatchPromptResponse[]

  /// "CASUAL" | "LONG_TERM" | "MARRIAGE_MINDED" | "UNSURE" — see src/domain/intent.ts
  intent             String   @default("UNSURE")
  intentLockedAt     DateTime?
  intentLockDays     Int      @default(30)

  preferenceProfile  PreferenceProfile?
  vouches            Vouch[]  @relation("VouchesReceived")
  vouchesGiven       Vouch[]  @relation("VouchesGiven")

  matchesAsA         Match[]  @relation("MatchUserA")
  matchesAsB         Match[]  @relation("MatchUserB")

  closureEventsSent      ClosureEvent[] @relation("ClosureSender")
  closureEventsReceived  ClosureEvent[] @relation("ClosureRecipient")

  escrowLedgerEntries EscrowLedgerEntry[]
  accountabilityLedgerEntries AccountabilityLedgerEntry[]
  payments           Payment[]
}

// One row per user: the output of the voice interview, structured by the
// LLM extraction step. `dealbreakers` and `values` are JSON string arrays;
// `vector` is a JSON-encoded float array standing in for a pgvector column.
model PreferenceProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])

  values         String   // JSON string[]
  dealbreakers   String   // JSON string[]
  attachmentStyle String  // e.g. "secure", "anxious", "avoidant", "fearful-avoidant"
  relationshipHistorySummary String
  vector         String   // JSON number[] — compatibility embedding
  rawTranscript  String   // full interview transcript, for future re-extraction

  updatedAt      DateTime @updatedAt
}

model Vouch {
  id           String   @id @default(cuid())
  voucherId    String
  voucher      User     @relation("VouchesGiven", fields: [voucherId], references: [id])
  voucheeId    String
  vouchee      User     @relation("VouchesReceived", fields: [voucheeId], references: [id])
  statement    String
  createdAt    DateTime @default(now())

  @@unique([voucherId, voucheeId])
}

model Match {
  id              String      @id @default(cuid())
  userAId         String
  userA           User        @relation("MatchUserA", fields: [userAId], references: [id])
  userBId         String
  userB           User        @relation("MatchUserB", fields: [userBId], references: [id])

  compatibilityScore Float
  scoreBreakdown  String      // JSON — per-dimension contributions, for explainability
  /// "PROPOSED" | "PENDING_APPROVAL" | "DECLINED" | "DATE_SCHEDULED" | "DATE_COMPLETED" | "CLOSED"
  status          String      @default("PROPOSED")
  createdAt       DateTime    @default(now())

  // Trust (src/domain/leveling.ts, src/domain/trustPrompts.ts): earned
  // mutually, from real prompt-response pairs where BOTH matched users
  // have answered — one side's honesty alone can't move it. Reaching
  // GUARANTEE_TRUST sets guaranteedAt once, permanently: a real,
  // database-backed "this connection is locked in."
  trust           Int         @default(0)
  guaranteedAt    DateTime?

  dates           DateProposal[]
  closureEvents   ClosureEvent[]
  promptResponses MatchPromptResponse[]

  @@unique([userAId, userBId])
}

model DateProposal {
  id          String     @id @default(cuid())
  matchId     String
  match       Match      @relation(fields: [matchId], references: [id])
  scheduledAt DateTime
  /// "SCHEDULED" | "CONFIRMED_ATTENDED" | "NO_SHOW" | "CANCELLED"
  status      String     @default("SCHEDULED")
  cancelledByUserId String?
  cancelledAt DateTime?  // set when marked CANCELLED — anchors the cancellation-ladder rolling window
  createdAt   DateTime   @default(now())
  attendedAt  DateTime?  // set when marked CONFIRMED_ATTENDED — starts the closure SLA clock
  noShowUserId String?   // set when marked NO_SHOW — the side who didn't show up
  noShowReportedAt DateTime? // when the counterparty reported it

  payment     Payment?
}

// The Closure Guarantee. Created whenever a match/date ends without moving
// forward. Silence is not modeled as a valid end state — every terminal
// transition on a Match must produce exactly one of these per direction
// that isn't continuing.
model ClosureEvent {
  id            String                 @id @default(cuid())
  matchId       String
  match         Match                  @relation(fields: [matchId], references: [id])
  senderId      String
  sender        User                   @relation("ClosureSender", fields: [senderId], references: [id])
  recipientId   String
  recipient     User                   @relation("ClosureRecipient", fields: [recipientId], references: [id])

  /// One of CLOSURE_REASON_TAXONOMY in src/domain/closure.ts
  reasonCategory String
  reasonNote     String?               // optional free text, sender's choice
  isAnonymous    Boolean               @default(false)
  deliveredAt    DateTime?             // null until the message is actually sent
  createdAt      DateTime              @default(now())
}

// Escrow deposits back the "give closure" commitment device: a deposit is
// held per active match and forfeited to the counterparty (as a credit) if
// the holder goes silent past the closure SLA instead of filing a
// ClosureEvent.
model EscrowLedgerEntry {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  matchId     String?
  amountCents Int      // positive = held/credited, negative = forfeited/debited
  reason      String   // "closure_deposit_held" | "closure_deposit_released" | "closure_forfeit" | ...
  createdAt   DateTime @default(now())
}

// Backs the cancellation ladder's rolling reset window: a SUSPENSION-tier
// cancellation dents accountabilityScore immediately *and* writes one of
// these with an expiresAt. Once that expires with no reversal on file, the
// scheduled sweep (src/domain/accountabilityReset.ts) credits the score
// back — the same rolling window that ages a cancellation out of the
// ladder's tier count also ages out the penalty it caused.
model AccountabilityLedgerEntry {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  dateProposalId String?
  delta          Float     // negative = penalty applied, positive = reversal credit
  /// "cancellation_suspension_penalty" | "cancellation_suspension_penalty_reversed"
  reason         String
  createdAt      DateTime  @default(now())
  expiresAt      DateTime? // when a penalty should auto-reverse; null on reversal entries
  reversedAt     DateTime? // set once the sweep reverses this penalty
}

// One row per (match, prompt, user): records how a real user chose to
// answer one of the shared trust-building prompts (src/domain/promptPool.ts)
// for a real match. A prompt only pays out trust to the Match once BOTH
// sides have answered it — see resolvePromptTrust in
// src/domain/trustPrompts.ts. XP is awarded to each user immediately on
// their own response, independent of the other side.
model MatchPromptResponse {
  id           String   @id @default(cuid())
  matchId      String
  match        Match    @relation(fields: [matchId], references: [id])
  promptIndex  Int      // index into the shared PROMPT_POOL array
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  /// "DIRECT" | "GUARDED" | "DEFLECT" — see RESPONSE_STYLES in src/domain/leveling.ts
  style        String
  createdAt    DateTime @default(now())

  @@unique([matchId, promptIndex, userId])
}

model Payment {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  dateProposalId String?       @unique
  dateProposal   DateProposal? @relation(fields: [dateProposalId], references: [id])

  /// "PAY_PER_DATE" | "SUCCESS_FEE" | "CANCELLATION_FEE"
  type           String
  amountCents    Int
  /// "PENDING" | "SUCCEEDED" | "FAILED" | "REFUNDED"
  status         String        @default("PENDING")
  providerRef    String?       // Stripe PaymentIntent id, etc.
  createdAt      DateTime      @default(now())
}
