DATABASE_URL="file:./dev.db"
PORT=3000

# Closure-SLA enforcement sweep (src/domain/silenceEnforcement.ts).
# Runs in-process on this interval by default — see src/jobs/scheduler.ts.
# Set to "true" if you're running multiple server instances and instead
# call `npm run job:enforce-silence` from a single external scheduler.
ENFORCE_SILENCE_DISABLED=false
ENFORCE_SILENCE_INTERVAL_MINUTES=15

# Cancellation-ladder accountability reset sweep (src/domain/accountabilityReset.ts).
# Auto-reverses a SUSPENSION-tier cancellation's score penalty once it ages
# out of the ladder's rolling window (CANCELLATION_WINDOW_DAYS in
# src/domain/dates.ts, 90 days by default). Same disable/interval pattern
# as above — use `npm run job:accountability-reset` from an external
# scheduler instead if you're running multiple server instances.
ACCOUNTABILITY_RESET_DISABLED=false
ACCOUNTABILITY_RESET_INTERVAL_MINUTES=60

# Real adapters are not wired up yet (see src/adapters/mock.ts) — set these
# once you're ready to replace a Mock* implementation with a Real one:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# DEEPGRAM_API_KEY=
# OPENAI_API_KEY=
# STRIPE_SECRET_KEY=
